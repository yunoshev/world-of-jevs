#!/usr/bin/env python3
"""Convert recorded original-AI shadow wire requests to exact Jev prompt batches.

This is offline and never calls a provider. It uses the same strict wire
contract and build_decision_plan function as the live gateway.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "gateway"))

from woj_gateway import jev  # noqa: E402
from woj_gateway.contract import DecideRequest  # noqa: E402
from woj_gateway.policy import validate_policy_file  # noqa: E402


def convert(row: dict, policy: object) -> dict:
    if row.get("event") != "original_jev_request" or row.get("control") != "original":
        raise ValueError("not an original-AI shadow request")
    request = DecideRequest.model_validate(row["request"])
    if request.state.behavior.policy_revision != policy.revision:
        raise ValueError("recorded and supplied policy revisions differ")
    plan = jev.build_decision_plan(request, policy=policy)
    return {
        "server_boot_id": request.server_boot_id,
        "request_id": request.request_id,
        "npc": request.npc.model_dump(),
        "snapshot_seq": request.snapshot_seq,
        "policy_revision": policy.revision,
        "control": "original",
        "label_status": "unlabelled_shadow_request",
        "gateway_request": request.model_dump(),
        "model_requests": [batch.payload for batch in plan.batches],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--log", type=Path, required=True,
                        help="WojCombat JSONL from an original-AI recording run")
    parser.add_argument("--policy", type=Path, required=True,
                        help="the exact policy revision used during the run")
    parser.add_argument("--out", type=Path, required=True,
                        help="new JSONL file; existing files are never overwritten")
    parser.add_argument("--boot-id", help="limit conversion to one server boot")
    parser.add_argument("--limit", type=int, default=0,
                        help="positive maximum number of records")
    args = parser.parse_args()
    if args.out.exists():
        parser.error(f"output already exists: {args.out}")
    policy = validate_policy_file(args.policy)
    args.out.parent.mkdir(parents=True, exist_ok=True)
    count = 0
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=args.out.parent,
                                         prefix=".shadow-", suffix=".jsonl",
                                         delete=False) as output:
            temporary = Path(output.name)
            with args.log.open(encoding="utf-8") as source:
                for line_number, line in enumerate(source, 1):
                    if '"event":"original_jev_request"' not in line:
                        continue
                    row = json.loads(line)
                    if args.boot_id and row.get("server_boot_id") != args.boot_id:
                        continue
                    try:
                        record = convert(row, policy)
                    except Exception as exc:
                        raise ValueError(f"{args.log}:{line_number}: {exc}") from exc
                    output.write(json.dumps(record, ensure_ascii=False,
                                            separators=(",", ":")) + "\n")
                    count += 1
                    if args.limit > 0 and count >= args.limit:
                        break
        if not count:
            raise ValueError("no matching original_jev_request rows")
        os.replace(temporary, args.out)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    print(f"exported {count} shadow Jev requests to {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
